# ── Credenciales ──────────────────────────────────────────────────────────
# Nunca deben viajar al repositorio: el paquete se distribuye a Colab desde aquí.
.env
.env.*
!.env.example
apikey.txt
*.key
*.json.secret

# ── Entorno ───────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── Corpus de tuits ───────────────────────────────────────────────────────
# Los CSV del corpus y las calificaciones SÍ viajan en el repositorio
# (repo privado: contienen tuits reales). Se excluyen solo formatos
# intermedios y respaldos; ver la sección de respaldos más abajo.
*.tsv
*.xlsx
*.xlsm
*.xls
*.parquet
*.feather
*.pkl
*.pickle

# ── Rúbrica ───────────────────────────────────────────────────────────────
# Los PDF de la rúbrica viajan en el repo (son la fuente de verdad, < 1 MB).
# rubrica.json se regenera del PDF y no se rastrea.
rubrica.json

# ── Checkpoints y salidas ─────────────────────────────────────────────────
# Append-only, crecen sin límite y contienen las justificaciones del modelo.
checkpoint*
*.jsonl
*.jsonl.*
graficas_*.html
*.log

# ── Respaldos y variantes con sufijo ──────────────────────────────────────
*.bak
*.bak_*
*.bak.*
*.antes
*.orig
*.tmp
*~

# ── Sistema / editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
